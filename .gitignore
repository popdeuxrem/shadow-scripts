# ═════════════════════════════════════════════════════════════════════
# GitIgnore - Hybrid CI/CD Project (CI-ready & Validator-compliant)
# ═════════════════════════════════════════════════════════════════════

# === Build Outputs / Generated Artifacts ===
dist/
.build/
out/
.turbo/
.build-cache/
.serverless/
.vercel/
.pnpm-store/
node_modules/
tmp/
apps/loader/public/ 

# Logs, temp files, caches
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.lcov
*.zip
*.tar
*.gz
*.sqlite
*.sqlite3

# Security Research / Obfuscation
obfuscated/
analysis/
reports/
findings/
qrcodes/
*.js.b64
*.js.enc
*.ob.js
*.obfuscated.js
*.mobileconfig
*.ovpn
*.conf
*.yaml
*.yml
*.pem
*.crt
*.key
*.pfx

# === Dependencies ===
.npm/
.yarn/
package-lock.json
yarn.lock
yarn-error.log*
.pnpm-debug.log*

# === IDE / Editor ===
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
Session.vim
.netrwhist
.DS_Store
Thumbs.db

# === Environment / Secrets ===
.env
.env.*
.env.local
.env*.local
*.secret
*.private
*.confidential
secrets/
keys/
credentials/
auth/
credentials.json
api-keys.json
webhook-urls.txt
secrets.json
.git-credentials

# === Cache / Temp Files ===
.cache/
.parcel-cache/
.webpack-cache/
.eslintcache
.stylelintcache
.nyc_output/
.next/
.nuxt/
.vuepress/

# === Testing / Coverage ===
coverage/
test-results/
playwright-report/
junit.xml

# === Exceptions - Must be version-controlled ===
!/.gitignore
!/README.md
!/LICENSE*
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/src-scripts/
!/scripts/
!/apps/
!/configs/
!/tsconfig.json
!/babel.config.*
!/webpack.config.*
!/rollup.config.*
!/vite.config.*
!/jest.config.*
!/vitest.config.*
!.github/
!Dockerfile*
!docker-compose.yml
!docker-compose.yaml
!.dockerignore
!k8s/
!kubernetes/
!docs/
!docs/**
!*.md
!*.MD
!*.png
!*.jpg
!*.jpeg
!*.svg
